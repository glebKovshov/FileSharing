set(CPACK_PACKAGE_NAME FileSharing)
set(CPACK_PACKAGE_VENDOR "FileSharing")
set(CPACK_PACKAGE_CONTACT "glebKovshov <kovshov.gleb@gmail.com>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Native Qt LAN file sharing")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY FileSharing)
set(CPACK_RESOURCE_FILE_README "${PROJECT_SOURCE_DIR}/README.md")
set(CPACK_MONOLITHIC_INSTALL ON)
set(CPACK_VERBATIM_VARIABLES ON)
get_target_property(QT_QMAKE_EXECUTABLE Qt6::qmake IMPORTED_LOCATION)
get_filename_component(QT_BIN_DIR "${QT_QMAKE_EXECUTABLE}" DIRECTORY)
if(WIN32)
    find_program(QT_DEPLOY_TOOL windeployqt HINTS "${QT_BIN_DIR}" REQUIRED)
    set(CPACK_GENERATOR NSIS ZIP)
    set(CPACK_NSIS_DISPLAY_NAME "FileSharing ${PROJECT_VERSION}")
    set(CPACK_NSIS_PACKAGE_NAME FileSharing)
    set(CPACK_NSIS_MODIFY_PATH OFF)
    set(CPACK_NSIS_EXECUTION_LEVEL user)
    set(CPACK_NSIS_INSTALL_ROOT "$LOCALAPPDATA")
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
    set(CPACK_NSIS_EXECUTABLES_DIRECTORY bin)
    set(CPACK_PACKAGE_EXECUTABLES FileSharing FileSharing)
    set(CPACK_NSIS_MUI_FINISHPAGE_RUN "FileSharing.exe")
    set(CPACK_NSIS_INSTALLED_ICON_NAME "bin\\FileSharing.exe")
    set(CPACK_NSIS_EXTRA_INSTALL_COMMANDS [[
      CreateShortCut "$DESKTOP\FileSharing.lnk" "$INSTDIR\bin\FileSharing.exe"
    ]])
    set(CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS [[
      Delete "$DESKTOP\FileSharing.lnk"
    ]])
    set(CPACK_PACKAGE_FILE_NAME "FileSharing-${PROJECT_VERSION}-windows-x64")
elseif(APPLE)
    find_program(QT_DEPLOY_TOOL macdeployqt HINTS "${QT_BIN_DIR}" REQUIRED)
    set(CPACK_GENERATOR DragNDrop)
    set(CPACK_DMG_VOLUME_NAME FileSharing)
    set(CPACK_PACKAGE_FILE_NAME "FileSharing-${PROJECT_VERSION}-macos-universal")
else()
    set(CPACK_GENERATOR DEB RPM TGZ)
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_SECTION net)
    set(CPACK_DEBIAN_PACKAGE_DEPENDS "libqt6svg6")
    set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
    set(CPACK_RPM_PACKAGE_AUTOREQ ON)
    set(CPACK_RPM_PACKAGE_REQUIRES "qt6-qtsvg")
    set(CPACK_RPM_PACKAGE_LICENSE "Proprietary")
    set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
    set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
    set(CPACK_PACKAGE_FILE_NAME "FileSharing-${PROJECT_VERSION}-linux-${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(WIN32 OR APPLE)
    configure_file("${PROJECT_SOURCE_DIR}/packaging/deploy.cmake.in" "${PROJECT_BINARY_DIR}/deploy.cmake" @ONLY)
    install(SCRIPT "${PROJECT_BINARY_DIR}/deploy.cmake")
endif()
include(CPack)
